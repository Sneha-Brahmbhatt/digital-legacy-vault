# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/digital_legacy_vault

# JWT Secrets (Generate secure random 64-character strings for production)
JWT_SECRET=your_jwt_access_secret_min_32_chars_replace_in_env
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_replace_in_env
JWT_REFRESH_EXPIRES_IN=7d

# Release Engine Settings
# Default grace period in hours (e.g. 48 for 2 days)
DEFAULT_GRACE_PERIOD_HOURS=48
# For development and academic demonstration (set in minutes to test quick transitions, e.g., 5; set 0 or unset to use hours)
GRACE_PERIOD_TEST_MINUTES=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Notification Provider (Resend)
# Optional in dev: If unset, notification service safely logs emails to console/audit log
RESEND_API_KEY=re_placeholder_api_key
FROM_EMAIL=vault-notifications@yourdomain.com

# Cloudinary Storage (Only for encrypted file blobs)
# Optional in dev: Local encrypted blob storage fallback is supported
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
